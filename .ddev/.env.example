# Copy to .ddev/.env and run `ddev restart`. .ddev/.env is gitignored.
ETRANSLATION_USERNAME=
ETRANSLATION_PASSWORD=
# callerInformation.username sent to eTranslation (max 10 chars).
ETRANSLATION_CALLER=eyi
# Optional fixed callback base URL. Ignored while a `ddev tunnel` is running.
CALLBACK_BASE_URL=
# Secret used to sign callback URLs. Generate with: openssl rand -hex 32
APP_SECRET=change-me
